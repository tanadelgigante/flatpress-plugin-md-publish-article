# ============================================================
# Caddy 2 — Protezione cartella di import (publisharticle plugin)
# ============================================================
# Copia questo blocco nella sezione del tuo sito nel Caddyfile.
# Sostituisci /fp-content/content/import-in/ con il percorso
# reale della cartella di import se diverso.
#
# NOTA: Caddy non legge .htaccess — questa protezione deve
# essere configurata direttamente nel Caddyfile.
# ============================================================

# --- Variante 1: protezione globale dell'intera cartella import ---
@import_deny {
    path /fp-content/content/import-in/*
}
handle @import_deny {
    respond "Forbidden" 403
}

# --- Variante 2: protezione di TUTTE le sottocartelle di import ---
# (inclusa done/ e failed/, in modo che i file elaborati
# non siano visibili nemmeno dopo l'importazione)
@import_deny_deep {
    path_reg ^/fp-content/content/import-in(/.*)?$
}
handle @import_deny_deep {
    respond "Forbidden" 403
}

# --- Variante 3: protezione solo della root, accessibile done/ e failed/ ---
# (usare questa se vuoi poter scaricare gli articoli già importati)
@import_deny_root {
    path /fp-content/content/import-in/*.md
    path /fp-content/content/import-in/*.markdown
    path /fp-content/content/import-in/*.mdown
    path /fp-content/content/import-in/*.txt
    path /fp-content/content/import-in/.htaccess
    path /fp-content/content/import-in/.caddy
}
handle @import_deny_root {
    respond "Forbidden" 403
}
